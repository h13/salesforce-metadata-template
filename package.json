{
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm run lint && pnpm run format:check",
    "deploy:sandbox": "sf project deploy start --target-org sandbox",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --no-error-on-unmatched-pattern scripts/",
    "retrieve": "bash scripts/retrieve.sh",
    "scan": "sf code-analyzer run --workspace . --view detail",
    "validate": "sf project deploy start --dry-run --target-org sandbox"
  },
  "devDependencies": {
    "@salesforce/cli": "2.158.7",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.28.12+sha512.94833387e35d503e8ad1010417cdeb82c120e7e69bafdf0a9db0690515beae7159274571e692b96abc2a085d3566fec54381afd978f65f64a85362dfd7e108f7"
}
