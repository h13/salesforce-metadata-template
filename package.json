{
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm run lint && pnpm run format:check",
    "deploy:sandbox": "sf project deploy start --target-org sandbox",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --no-error-on-unmatched-pattern scripts/",
    "retrieve": "bash scripts/retrieve.sh",
    "scan": "sf code-analyzer run --workspace . --view detail",
    "validate": "sf project deploy start --dry-run --target-org sandbox"
  },
  "devDependencies": {
    "@salesforce/cli": "^2.144.6",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.28.11+sha512.740184d10f81f5d5b165be88560ee7ba62406c4134896abc27a580109eec2f47c1e41d91251c944c2cababcb1c22461799ebb72de2ec625af2030b0e36c735a3"
}
