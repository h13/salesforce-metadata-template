{
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "baseline": "bash scripts/baseline.sh",
    "check": "pnpm run lint && pnpm run format:check",
    "deploy": "bash scripts/deploy.sh",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --no-error-on-unmatched-pattern scripts/",
    "login": "bash scripts/login.sh",
    "retrieve": "bash scripts/retrieve.sh",
    "scan": "sf code-analyzer run --workspace . --view detail",
    "scan:all": "bash scripts/scan-all.sh",
    "validate": "bash scripts/validate.sh"
  },
  "devDependencies": {
    "@salesforce/cli": "2.159.7",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
